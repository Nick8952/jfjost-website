# Kopie als .env.local anlegen. Die Demo auf GitHub Pages braucht KEINE dieser Variablen.
# Alle Werte hier sind leer; echte Werte gehören nie ins Repository.

# ---- Sanity (erst nach dem Anlegen des Sanity-Projekts, siehe docs/sanity-vercel-einrichtung.md)
# Projekt-ID und Dataset sind Kennungen, keine Geheimnisse.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Nur für scripts/sanity-seed.mts (Schreibrechte). Niemals als NEXT_PUBLIC_ verwenden.
SANITY_API_WRITE_TOKEN=
# Nur für den Webhook «Inhalt veröffentlicht -> Vercel neu bauen»
SANITY_REVALIDATE_SECRET=

# ---- Build-Profil
# pages  = statischer Export für GitHub Pages (Standard)
# vercel = Server-Build für Vercel
DEPLOY_TARGET=pages
# Repository-Unterpfad auf GitHub Pages, z. B. /jfjost-website. Leer lassen für Vercel.
NEXT_PUBLIC_BASE_PATH=
# Öffentliche Adresse ohne Unterpfad, für Canonical/OG (Vercel oder Kundendomain).
# Leer lassen ist erlaubt: dann gilt die Vercel-Adresse bzw. GitHub Pages.
NEXT_PUBLIC_SITE_URL=
# Erst nach dem Go-Live auf der Kundendomain auf "ja" setzen: hebt noindex auf und
# liefert sitemap.xml aus. Auf der Demo bleibt die Variable leer.
NEXT_PUBLIC_INDEXIEREN=
